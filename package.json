{
  "name": "dsh-peer-chat",
  "version": "2.3.1",
  "description": "Talk to another DSH instance: send, ask, steer, chain and read back — peers are addressed by port and the web token is discovered automatically. 让一个 DSH 实例直接和另一个实例对话：对端用端口标识，token 自动识别。",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "preview.html",
    "vendor",
    "locale",
    "scripts",
    "docs",
    "site",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "INSTALL.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@ryuu-64/dsh-session-tools": ">=0.8.0",
    "dsh-session-plus": "*"
  },
  "peerDependenciesMeta": {
    "@ryuu-64/dsh-session-tools": {
      "optional": true
    },
    "dsh-session-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "cross-instance",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "dsh-peer-chat contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kewn/dsh-peer-chat.git"
  },
  "homepage": "https://github.com/kewn/dsh-peer-chat#readme",
  "bugs": {
    "url": "https://github.com/kewn/dsh-peer-chat/issues"
  }
}
